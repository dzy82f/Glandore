<?php
/**
 * Community of Practice – Type and Taxonomy Registration
 *
 * @package glandore
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

/**
 * Register CoP Thread post type and Topic Canopy taxonomy.
 */
function glandore_register_cop_types() {

	// CoP Threads.
	register_post_type(
		'cop_thread',
		[
			'label'               => 'CoP Threads',
			'public'              => true,
			'show_in_rest'        => true,
			'has_archive'         => true,
			'publicly_queryable'  => true,
			'show_ui'             => true,
			'show_in_menu'        => true,
			'exclude_from_search' => false,
			'supports'            => [ 'title', 'editor', 'author', 'comments' ],
			'menu_position'       => 22,
			'menu_icon'           => 'dashicons-networking',
			'labels'              => [
				'name'          => 'CoP Threads',
				'singular_name' => 'CoP Thread',
				'add_new'       => 'Add New CoP Thread',
				'add_new_item'  => 'Add New CoP Thread',
				'edit_item'     => 'Edit CoP Thread',
				'new_item'      => 'New CoP Thread',
				'view_item'     => 'View CoP Thread',
			],
		]
	);

	// Topic Canopies.
	register_taxonomy(
		'cop_canopy',
		[ 'cop_thread' ],
		[
			'label'             => 'Topic Canopies',
			'public'            => true,
			'hierarchical'      => false,
			'show_ui'           => true,
			'show_in_rest'      => true,
			'show_admin_column' => true,
			'labels'            => [
				'name'          => 'Topic Canopies',
				'singular_name' => 'Topic Canopy',
				'add_new_item'  => 'Add New Topic Canopy',
				'edit_item'     => 'Edit Topic Canopy',
			],
		]
	);
}
add_action( 'init', 'glandore_register_cop_types' );

